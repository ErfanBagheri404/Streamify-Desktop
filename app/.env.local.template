# Runtime configuration for Streamify Desktop.
# In a packaged desktop build, the API runs in-process on 127.0.0.1:7861.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STREAMIFY_PROVIDER_ENDPOINTS_URL=http://127.0.0.1:7861/config
NEXT_PUBLIC_STREAMIFY_API_MODE=absolute
NEXT_PUBLIC_STREAMIFY_API_BASE_URL=http://127.0.0.1:7861, https://helloify-api.hf.space, https://api.streamify.workers.dev
NEXT_PUBLIC_STREAMIFY_API_ROUTES=/video,/audio-proxy,/license-proxy,/search,/artist,/collection,/lyrics

# Cloud-sync and auth.
#
# The two NEXT_PUBLIC_SUPABASE_* values below are baked into every web bundle
# and installer — they are public by design (the browser needs them) and RLS
# enforces the real access control. The service-role key is a SERVER secret:
# it must NEVER appear in this template or any build output. CI supplies the
# real file via the APP_ENV_LOCAL secret on release builds.
