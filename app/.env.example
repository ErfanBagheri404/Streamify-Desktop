# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Desktop runs the API in-process on 127.0.0.1:7861 (Electron main process).
# Hosted deployments stay as ordered fallbacks; backend-api.ts retries on
# 403/404/429/5xx so a local miss falls through automatically.
NEXT_PUBLIC_STREAMIFY_API_MODE=absolute
NEXT_PUBLIC_STREAMIFY_API_BASE_URL=http://127.0.0.1:7861
NEXT_PUBLIC_STREAMIFY_API_ROUTES=/video,/audio-proxy,/license-proxy,/search,/artist,/collection,/lyrics,/itunes,/deezer,/resolve-jiosaavn

NEXT_PUBLIC_SESSION_URL=
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
